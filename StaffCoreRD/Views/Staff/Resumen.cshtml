@model IEnumerable<StaffCoreRD.Models.DepartamentoResumenViewModel>
@{
    ViewData["Title"] = "Resumen por Departamento";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark"><i class="fa-solid fa-chart-pie me-2"></i>Resumen por Departamento</h2>
        <p class="text-muted mb-0">Totales de personal y nómina agrupados por área</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Volver a Nómina
    </a>
</div>

<div class="row g-4 mb-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-3">
            <div class="card card-custom h-100 p-3 text-center">
                <div class="card-body">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:60px;height:60px;">
                        <i class="fa-solid fa-building fa-lg"></i>
                    </div>
                    <h5 class="fw-bold text-dark">@item.Departamento</h5>
                    <p class="mb-1 text-muted">
                        <i class="fa-solid fa-users me-1"></i> @item.TotalEmpleados empleado(s)
                    </p>
                    <p class="fw-bold text-success fs-5 mb-0">
                        RD$ @item.TotalNomina.ToString("N2")
                    </p>
                </div>
            </div>
        </div>
    }
</div>

<div class="card card-custom p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle table-custom">
            <thead>
                <tr>
                    <th>Departamento</th>
                    <th class="text-center">Total Empleados</th>
                    <th class="text-end">Total Nómina</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="badge bg-primary">@item.Departamento</span></td>
                        <td class="text-center">@item.TotalEmpleados</td>
                        <td class="text-end fw-bold text-success">RD$ @item.TotalNomina.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-dark fw-bold">
                    <td>Total General</td>
                    <td class="text-center">@Model.Sum(x => x.TotalEmpleados)</td>
                    <td class="text-end text-warning">RD$ @Model.Sum(x => x.TotalNomina).ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>