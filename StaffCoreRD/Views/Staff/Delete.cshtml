@model StaffCoreRD.Models.Staff
@{
    ViewData["Title"] = "Eliminar Empleado";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-custom border-danger p-4 shadow">
            <div class="text-center text-danger mb-3">
                <i class="fa-solid fa-triangle-exclamation fa-3x"></i>
                <h3 class="fw-bold mt-2">¿Confirmar Eliminación?</h3>
                <p class="text-muted">Esta acción no se puede deshacer.</p>
            </div>

            <div class="card bg-light p-3 mb-4 rounded">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Nombre:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Nombre</dd>

                    <dt class="col-sm-4">Cédula:</dt>
                    <dd class="col-sm-8">@Model.Cedula</dd>

                    <dt class="col-sm-4">Cargo:</dt>
                    <dd class="col-sm-8">@Model.Cargo</dd>

                    <dt class="col-sm-4">Departamento:</dt>
                    <dd class="col-sm-8">@Model.Departamento</dd>

                    <dt class="col-sm-4">Salario:</dt>
                    <dd class="col-sm-8 text-success fw-bold">RD$ @Model.Salario.ToString("N2")</dd>
                </dl>
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-danger px-4 fw-bold">Sí, Eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>