@model StaffCoreRD.Models.Staff
@{
    ViewData["Title"] = "Detalles del Empleado";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-custom p-4">
            <div class="d-flex align-items-center mb-3">
                <div class="bg-primary text-white rounded-circle p-3 me-3">
                    <i class="fa-solid fa-user fa-2x"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">@Model.Nombre</h3>
                    <span class="badge bg-secondary">@Model.Cargo</span>
                </div>
            </div>
            <hr />
            <dl class="row">
                <dt class="col-sm-4">Cédula:</dt>
                <dd class="col-sm-8">@Model.Cedula</dd>

                <dt class="col-sm-4">Departamento:</dt>
                <dd class="col-sm-8"><span class="badge bg-info text-dark">@Model.Departamento</span></dd>

                <dt class="col-sm-4">Salario Mensual:</dt>
                <dd class="col-sm-8 text-success fw-bold">RD$ @Model.Salario.ToString("N2")</dd>

                <dt class="col-sm-4">Fecha de Ingreso:</dt>
                <dd class="col-sm-8">@Model.FechaIngreso.ToString("dd/MM/yyyy")</dd>
            </dl>
            <div class="mt-3">
                <a asp-action="Index" class="btn btn-secondary">Regresar</a>
            </div>
        </div>
    </div>
</div>