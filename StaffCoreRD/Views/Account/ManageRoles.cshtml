@model IEnumerable<StaffCoreRD.Models.UserRoleViewModel>

@{
    ViewData["Title"] = "Gestión de Roles";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fa-solid fa-users-gear text-primary me-2"></i>Gestión de Roles de Usuarios</h2>
        <a asp-controller="Staff" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver a Nómina
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Correo Electrónico</th>
                        <th>Rol Actual</th>
                        <th class="text-center">Cambiar Rol</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-bold">@user.Email</td>
                            <td>
                                @if (user.RoleActual == "Administrador")
                                {
                                    <span class="badge bg-danger fs-6"><i class="fa-solid fa-user-shield me-1"></i> Administrador</span>
                                }
                                else if (user.RoleActual == "RRHH")
                                {
                                    <span class="badge bg-primary fs-6"><i class="fa-solid fa-user-tie me-1"></i> RRHH</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary fs-6"><i class="fa-solid fa-user me-1"></i> Viewer</span>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="ChangeRole" method="post" class="d-flex justify-content-center gap-2">
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    <select name="newRole" class="form-select form-select-sm w-auto">
                                        <option value="Administrador" selected="@(user.RoleActual == "Administrador")">Administrador</option>
                                        <option value="RRHH" selected="@(user.RoleActual == "RRHH")">RRHH</option>
                                        <option value="Viewer" selected="@(user.RoleActual == "Viewer")">Viewer</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="fa-solid fa-floppy-disk me-1"></i> Guardar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
  
