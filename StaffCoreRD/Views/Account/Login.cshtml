@model StaffCoreRD.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center my-5">
    <div class="col-md-5">
        <div class="card card-custom p-4">
            <div class="text-center mb-4">
                <i class="fa-solid fa-user-lock text-primary fa-3x mb-2"></i>
                <h3 class="fw-bold">Acceso al Sistema</h3>
                <p class="text-muted small">Ingresa tus credenciales institucionales</p>
            </div>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-semibold"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label font-weight-bold">Correo Electrónico</label>
                    <input asp-for="Email" class="form-control form-control-lg" placeholder="ejemplo@staffcore.rd" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <input asp-for="Password" class="form-control form-control-lg" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input class="form-check-input" asp-for="RememberMe" />
                    <label class="form-check-label" asp-for="RememberMe"></label>
                </div>

                <button type="submit" class="btn btn-primary-custom text-white w-100 shadow-sm py-2 fs-5">
                    Ingresar <i class="fa-solid fa-arrow-right-to-bracket ms-2"></i>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}